{
  "id": null,
  "uid": "sherlock-vm",
  "title": "VM Performance",
  "tags": ["sherlock-logs", "vm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [{"name": "instance", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(node_uname_info, instance)", "includeAll": true, "multi": true, "refresh": 1}]
  },
  "panels": [
    {"type": "timeseries", "title": "CPU usage %", "id": 1, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}},
    {"type": "timeseries", "title": "Memory utilization %", "id": 2, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "(1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}) * 100", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}},
    {"type": "timeseries", "title": "Disk I/O bytes/s", "id": 3, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by(instance) (rate(node_disk_read_bytes_total{instance=~\"$instance\"}[5m]))", "legendFormat": "read {{instance}}"}, {"expr": "sum by(instance) (rate(node_disk_written_bytes_total{instance=~\"$instance\"}[5m]))", "legendFormat": "write {{instance}}"}], "fieldConfig": {"defaults": {"unit": "Bps"}}},
    {"type": "timeseries", "title": "Network traffic", "id": 4, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by(instance) (rate(node_network_receive_bytes_total{device!~\"lo\",instance=~\"$instance\"}[5m]))", "legendFormat": "rx {{instance}}"}, {"expr": "sum by(instance) (rate(node_network_transmit_bytes_total{device!~\"lo\",instance=~\"$instance\"}[5m]))", "legendFormat": "tx {{instance}}"}], "fieldConfig": {"defaults": {"unit": "Bps"}}}
  ]
}
